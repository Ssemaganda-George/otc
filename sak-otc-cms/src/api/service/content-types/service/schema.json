{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "displayName": "Service",
    "singularName": "service",
    "pluralName": "services",
    "description": "Services offered by OneTechConnect"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "richtext",
      "required": true
    },
    "detailedContent": {
      "type": "richtext",
      "required": true
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "litigation",
        "innovation",
        "consultancy",
        "research",
        "training",
        "advocacy"
      ],
      "required": true
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "required": false
    },
    "order": {
      "type": "integer",
      "required": false,
      "default": 0
    },
    "contactEmail": {
      "type": "email",
      "required": false
    },
    "relatedServices": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::service.service"
    }
  }
}
