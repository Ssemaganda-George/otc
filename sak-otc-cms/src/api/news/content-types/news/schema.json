{
  "kind": "collectionType",
  "collectionName": "news",
  "info": {
    "displayName": "News",
    "singularName": "news",
    "pluralName": "news",
    "description": "News and updates content"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": true
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "author": {
      "type": "string",
      "required": true
    },
    "publishDate": {
      "type": "datetime",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "announcement",
        "research",
        "partnership",
        "event",
        "publication",
        "award"
      ],
      "required": true
    },
    "tags": {
      "type": "json",
      "required": false
    },
    "externalUrl": {
      "type": "string",
      "required": false
    },
    "isFeatured": {
      "type": "boolean",
      "default": false,
      "required": false
    }
  }
}
