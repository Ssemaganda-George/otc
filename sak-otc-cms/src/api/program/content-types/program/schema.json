{
  "kind": "collectionType",
  "collectionName": "programs",
  "info": {
    "displayName": "Program",
    "singularName": "program",
    "pluralName": "programs",
    "description": "Programs and initiatives by OneTechConnect"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "acronym": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "richtext",
      "required": true
    },
    "detailedContent": {
      "type": "richtext",
      "required": true
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "education",
        "research",
        "advocacy",
        "innovation",
        "partnership",
        "capacity-building"
      ],
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "active",
        "completed",
        "planned",
        "on-hold"
      ],
      "default": "active",
      "required": true
    },
    "startDate": {
      "type": "date",
      "required": false
    },
    "endDate": {
      "type": "date",
      "required": false
    },
    "website": {
      "type": "string",
      "required": false
    },
    "contactEmail": {
      "type": "email",
      "required": false
    },
    "objectives": {
      "type": "richtext",
      "required": false
    },
    "partners": {
      "type": "json",
      "required": false
    },
    "isFeatured": {
      "type": "boolean",
      "default": false,
      "required": false
    },
    "order": {
      "type": "integer",
      "required": false,
      "default": 0
    }
  }
}
