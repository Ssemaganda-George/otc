{
  "kind": "singleType",
  "collectionName": "about_pages",
  "info": {
    "displayName": "About Page",
    "singularName": "about-page",
    "pluralName": "about-pages",
    "description": "Content for the About page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "default": "About OneTechConnect"
    },
    "subtitle": {
      "type": "string",
      "default": "Championing Africa's technological and digital justice"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "mission": {
      "type": "richtext",
      "required": true
    },
    "vision": {
      "type": "richtext",
      "required": true
    },
    "values": {
      "type": "richtext",
      "required": true
    },
    "approach": {
      "type": "richtext",
      "required": true
    },
    "history": {
      "type": "richtext",
      "required": false
    },
    "teamSection": {
      "type": "richtext",
      "required": false
    }
  }
}