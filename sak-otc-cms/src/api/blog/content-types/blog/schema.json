{
  "kind": "collectionType",
  "collectionName": "blogs",
  "info": {
    "displayName": "Blog",
    "singularName": "blog",
    "pluralName": "blogs",
    "description": "Blog posts and articles"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": true
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "author": {
      "type": "string",
      "required": true
    },
    "publishDate": {
      "type": "datetime",
      "required": true
    },
    "readTime": {
      "type": "integer",
      "required": false
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "technology",
        "law",
        "policy",
        "innovation",
        "research",
        "opinion",
        "case-study",
        "tutorial"
      ],
      "required": true
    },
    "tags": {
      "type": "json",
      "required": false
    },
    "isFeatured": {
      "type": "boolean",
      "default": false,
      "required": false
    },
    "seoTitle": {
      "type": "string",
      "required": false
    },
    "seoDescription": {
      "type": "text",
      "required": false
    },
    "relatedPosts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::blog.blog"
    }
  }
}